{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barza-order-api",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-16",
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://mir4zzz.github.io,http://localhost:8000,http://127.0.0.1:8000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "barza-orders",
      "database_id": "af153ed8-665e-4669-9928-47eefef1b365",
      "migrations_dir": "migrations"
    }
  ]
}
